{
  "name": "kuadrant-console-plugin",
  "version": "0.6.0",
  "description": "Kuadrant OpenShift Console plugin",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuadrant/kuadrant-console-plugin.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn clean && NODE_ENV=production yarn webpack",
    "build-dev": "yarn clean && yarn webpack",
    "start": "yarn webpack serve --progress",
    "start-console": "./start-console.sh",
    "i18n": "./i18n-scripts/build-i18n.sh && node ./i18n-scripts/set-english-defaults.js",
    "lint": "yarn eslint src --fix && stylelint 'src/**/*.css' --allow-empty-input --fix",
    "test": "jest",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "check:spec-map": "bash build/check-spec-map.sh",
    "test:e2e:setup": "./e2e/setup.sh",
    "test:e2e:teardown": "./e2e/teardown.sh",
    "webpack": "node -r ts-node/register ./node_modules/.bin/webpack",
    "downstream-replacements": "node downstream.js && yarn i18n && yarn lint",
    "upstream-replacements": "node downstream.js --upstream && yarn i18n && yarn lint"
  },
  "resolutions": {
    "fast-uri": "^3.1.5",
    "follow-redirects": "^1.16.0",
    "tar": "^7.5.22",
    "http-proxy-middleware": "2.0.7",
    "immutable": "3.8.3",
    "lodash": "4.18.0",
    "node-forge": "^1.3.2",
    "qs": "6.14.1",
    "brace-expansion@^5": "^5.0.7"
  },
  "devDependencies": {
    "@openshift-console/dynamic-plugin-sdk": "patch:@openshift-console/dynamic-plugin-sdk@npm%3A4.22.0#~/.yarn/patches/@openshift-console-dynamic-plugin-sdk-npm-4.22.0-40a905f3df.patch",
    "@openshift-console/dynamic-plugin-sdk-webpack": "4.22.0",
    "@patternfly/react-core": "^6.4.0",
    "@patternfly/react-icons": "^6.4.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-helmet": "^6.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.7.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^2.7.1",
    "prettier-stylelint": "^0.4.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet": "^6.1.0",
    "react-i18next": "~16.5.8",
    "react-router": "~7.18.1",
    "style-loader": "^3.3.1",
    "stylelint": "^15.3.0",
    "stylelint-config-standard": "^31.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.8.1",
    "typescript": "^5.9.3",
    "webpack": "^5.100.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.6"
  },
  "consolePlugin": {
    "name": "kuadrant-console-plugin",
    "version": "0.6.0",
    "displayName": "Kuadrant OpenShift Console Plugin",
    "description": "Kuadrant OpenShift Console Plugin",
    "latestSupportedOpenshiftVersion": "4.22",
    "i18n": {
      "loadType": "Preload"
    },
    "exposedModules": {
      "KuadrantOverviewPage": "./components/KuadrantOverviewPage",
      "PolicyTopologyPage": "./components/PolicyTopologyPage",
      "KuadrantPoliciesPage": "./components/KuadrantPoliciesPage",
      "KuadrantDNSPolicyCreatePage": "./components/KuadrantDNSPolicyCreatePage",
      "KuadrantAuthPolicyCreatePage": "./components/KuadrantAuthPolicyCreatePage",
      "KuadrantRateLimitPolicyCreatePage": "./components/KuadrantRateLimitPolicyCreatePage",
      "KuadrantTokenRateLimitPolicyCreatePage": "./components/KuadrantTokenRateLimitPolicyCreatePage",
      "KuadrantOIDCPolicyCreatePage": "./components/KuadrantOIDCPolicyCreatePage",
      "KuadrantPlanPolicyCreatePage": "./components/KuadrantPlanPolicyCreatePage",
      "KuadrantTLSCreatePage": "./components/KuadrantTLSCreatePage",
      "PolicyTargetRefPage": "./components/PolicyTargetRefPage",
      "APIProductCreatePage": "./components/apiproduct/APIProductCreatePage",
      "APIProductsListPage": "./components/apiproduct/APIProductsListPage",
      "APIProductOverviewTab": "./components/apiproduct/APIProductOverviewTab",
      "APIProductPoliciesTab": "./components/apiproduct/APIProductPoliciesTab",
      "APIProductDefinitionTab": "./components/apiproduct/APIProductDefinitionTab",
      "APIProductAPIKeysTab": "./components/apiproduct/APIProductAPIKeysTab",
      "MyAPIKeysPage": "./components/apikey/MyAPIKeysPage",
      "APIKeyDetailPage": "./components/apikey/APIKeyDetailPage",
      "APIKeyApprovalPage": "./components/apikey/APIKeyApprovalPage",
      "useAPIProductActions": "./components/apiproduct/useAPIProductActions",
      "useDNSPolicyActions": "./components/dnspolicy/useDNSPolicyActions",
      "useTLSPolicyActions": "./components/tlspolicy/useTLSPolicyActions",
      "useOIDCPolicyActions": "./components/oidcpolicy/useOIDCPolicyActions",
      "useTokenRateLimitPolicyActions": "./components/tokenratelimitpolicy/useTokenRateLimitPolicyActions",
      "usePlanPolicyActions": "./components/planpolicy/usePlanPolicyActions",
      "GRPCRoutePoliciesPage": "./components/GRPCRoutePoliciesPage",
      "GatewayCreatePage": "./components/gateway/GatewayCreatePage",
      "useGatewayActions": "./components/gateway/useGatewayActions",
      "gatewayActionFilter": "./components/gateway/gatewayActionFilter",
      "HTTPRouteCreatePage": "./components/httproute/HTTPRouteCreatePage",
      "useHTTPRouteActions": "./components/httproute/useHTTPRouteActions",
      "GatewaySingleOverview": "./components/gateway/GatewaySingleOverview",
      "HTTPRouteSingleOverview": "./components/httproute/HTTPRouteSingleOverview",
      "MCPOverviewPage": "./components/mcp/MCPOverviewPage",
      "MCPSetupWizard": "./components/mcp/MCPSetupWizard"
    },
    "dependencies": {
      "@console/pluginAPI": ">=4.22.0-0"
    }
  },
  "dependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@patternfly/react-data-view": "6.4.0-prerelease.12",
    "@patternfly/react-table": "^6.4.0",
    "@patternfly/react-topology": "~6.4.0",
    "babel-loader": "^8.2.0",
    "graphlib": "^2.1.8",
    "graphlib-dot": "^0.6.4",
    "i18next": "^25.8.0",
    "i18next-parser": "^9.0.1",
    "js-yaml": "^4.3.1",
    "pluralize": "^8.0.0",
    "swagger-ui-react": "5.10.5"
  },
  "packageManager": "yarn@4.12.0"
}
